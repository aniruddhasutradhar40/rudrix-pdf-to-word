# ---------- Backend (copy to backend/.env or set in your host's dashboard) ----------
# Comma-separated list of frontend origins allowed by CORS (no trailing slash).
RUDRIX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
RUDRIX_MAX_UPLOAD_MB=25
RUDRIX_MAX_PAGES=100
RUDRIX_OCR_MAX_PAGES=30
RUDRIX_TIMEOUT_SECONDS=240
RUDRIX_FILE_TTL_SECONDS=900
RUDRIX_MAX_CONCURRENT=2
RUDRIX_RATE_LIMIT_PER_MIN=10
# Set true only when running behind a trusted reverse proxy (Render, Railway, Nginx).
RUDRIX_TRUST_PROXY=false
# Optional: where temporary files go (defaults to the system temp dir).
# RUDRIX_WORK_DIR=/tmp/rudrix_jobs
# Optional: page-count check through LibreOffice when it is installed (true/false).
RUDRIX_QUALITY_RENDER=true

# ---------- Frontend (set in Vercel -> Project Settings -> Environment Variables) ----------
# Public URL of the deployed Python backend, no trailing slash.
RUDRIX_API_URL=http://localhost:8000
